# Server Port
PORT=5000

# Security / Session Secret
SECRET_KEY=change_this_to_a_secure_random_secret_in_production

# AI Provider API Keys (configured securely on the server)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Optional OCR Tool Paths (Windows fallback for scanned PDFs)
# POPPLER_PATH=C:\Program Files\Poppler\bin
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
