FROM python:3.10-slim

WORKDIR /app

# Install system dependencies (Poppler for PDF and Tesseract for OCR)
RUN apt-get update && apt-get install -y \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-lao \
    tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Ensure data and uploads directories exist
RUN mkdir -p uploads/avatars database_data

# Create a start script
RUN echo '#!/bin/bash\n\
gunicorn -w 4 -k uvicorn.workers.UvicornWorker app:app -b 0.0.0.0:5000\n\
' > start.sh && chmod +x start.sh

EXPOSE 5000

CMD ["./start.sh"]
